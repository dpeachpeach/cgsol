# cgsol configuration.
#
# Two modes. Replay is the default and needs nothing in this file at all —
# every variable below is marked replay-optional or full-required.
#
# Copy to `.env`; never commit the copy. Compose reads it through `env_file`,
# so this file is the only place these settings are read from: exporting one in
# your shell instead reaches only the handful of variables docker-compose.yml
# enumerates, and the rest — including the spend cap — are silently ignored.

# --- mode ---------------------------------------------------------------------
# replay-optional. true (default) serves a recorded/simulated run with no
# outbound network. false runs against the real fork and real Devin sessions.
REPLAY=true
# replay-optional. Wrap outbound HTTP and dump cassettes to fixtures/ during a
# live dress rehearsal.
RECORD=false

# --- GitHub -------------------------------------------------------------------
# full-required. The fork. Never apache/superset.
GITHUB_REPO=dpeachpeach/superset-cg
# Fallback credential. repo scope, minted by hand, never expires — which is why
# the app below is preferred. Still used when no app is configured, and unused
# in replay.
GITHUB_TOKEN=
# Shared with the webhook; every delivery is HMAC-verified. `make github-app`
# writes this for you (the app generates it).
GITHUB_WEBHOOK_SECRET=
# The tunnel GitHub delivers to. `make github-app` mints a channel when unset.
SMEE_URL=

# --- GitHub App (preferred; all four written by `make github-app`) -------------
# The app is the identity, the webhook and the webhook secret in one object, and
# the orchestrator mints its own hour-long installation tokens from it. Set these
# and GITHUB_TOKEN stops being read.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The PEM, base64-encoded onto one line. A secret: never commit a filled-in .env.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# --- Devin --------------------------------------------------------------------
# full-required. A service-user key with the org-level `UseDevinSessions`
# permission: the v3 endpoints below are org-scoped and reject personal keys.
DEVIN_API_KEY=
# full-required, org- prefixed. Everything (bootstrap, dispatch, polling) runs
# against /v3/organizations/$DEVIN_ORG_ID/*. Leave it empty and the client falls
# back to the v1 endpoints, which work with a personal key but report no ACU burn.
DEVIN_ORG_ID=

# Written by `make bootstrap` from devin/playbooks/*.yaml. Do not hand-edit.
PLAYBOOK_TRIAGE_SCOUT=
PLAYBOOK_REMEDIATE_TRIVIAL=
PLAYBOOK_REMEDIATE_MEDIUM=
PLAYBOOK_REMEDIATE_HARD=
PLAYBOOK_CI_AUTOFIX=
KNOWLEDGE_SUPERSET_CONVENTIONS=

# --- triage cadence -----------------------------------------------------------
# auto: triage each issue as its webhook arrives.
# chunked: sweep the untriaged backlog every TRIAGE_INTERVAL_SECONDS.
# manual: nothing is triaged until someone presses the button.
TRIAGE_MODE=manual
TRIAGE_INTERVAL_SECONDS=1800

# --- policy (replay-optional; the dashboard can change these at runtime) ------
# The verdicts below this go to human-review instead of a worker. Low on
# purpose: the analyst's own eligibility call is the gate, and this catches
# only the verdicts it barely believes. 0 disables it.
CONFIDENCE_THRESHOLD=0.3
MAX_CI_ROUNDS=3
# A session whose result has been consumed is terminated; left alone it idles at
# waiting_for_user forever and holds a worker slot. Set false to inspect them.
TERMINATE_CONSUMED_SESSIONS=true
# The spend switch, and the one setting worth reading twice. Workers are
# dispatched off the poll loop, not off a button, so any value above 0 in live
# mode means the next eligible issue starts a paid Devin session on its own.
# Left unset, as below, live starts at 0 and replay — whose sessions are
# simulated and free — runs the demo at 6. Setting it applies to both, so an
# uncommented 0 here also stops the replay board from moving.
# MAX_CONCURRENT_WORKERS=0
SCOUT_BATCH_MAX=25
BATCH_WINDOW_SECONDS=60
