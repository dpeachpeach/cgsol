# cgsol configuration.
#
# Two modes. Replay is the default and needs nothing in this file at all —
# every variable below is marked replay-optional or full-required.

# --- mode ---------------------------------------------------------------------
# replay-optional. true (default) serves a recorded/simulated run with no
# outbound network. false runs against the real fork and real Devin sessions.
REPLAY=true
# replay-optional. Wrap outbound HTTP and dump cassettes to fixtures/ during a
# live dress rehearsal.
RECORD=false

# --- GitHub -------------------------------------------------------------------
# full-required. The fork. Never apache/superset.
GITHUB_REPO=dpeachpeach/superset-cg
# full-required. repo scope. Not used at all in replay.
GITHUB_TOKEN=
# full-required. Shared with the webhook; every delivery is HMAC-verified.
GITHUB_WEBHOOK_SECRET=
# full-required for `make live`. https://smee.io/new
SMEE_URL=

# --- Devin --------------------------------------------------------------------
# full-required. A service-user key with the org-level `UseDevinSessions`
# permission: the v3 endpoints below are org-scoped and reject personal keys.
DEVIN_API_KEY=
# full-required, org- prefixed. Everything (bootstrap, dispatch, polling) runs
# against /v3/organizations/$DEVIN_ORG_ID/*. Leave it empty and the client falls
# back to the v1 endpoints, which work with a personal key but report no ACU burn.
DEVIN_ORG_ID=

# Written by `make bootstrap` from devin/playbooks/*.yaml. Do not hand-edit.
PLAYBOOK_TRIAGE_SCOUT=
PLAYBOOK_REMEDIATE_TRIVIAL=
PLAYBOOK_REMEDIATE_MEDIUM=
PLAYBOOK_REMEDIATE_HARD=
PLAYBOOK_CI_AUTOFIX=
KNOWLEDGE_SUPERSET_CONVENTIONS=

# --- triage cadence -----------------------------------------------------------
# auto: triage each issue as its webhook arrives.
# chunked: sweep the untriaged backlog every TRIAGE_INTERVAL_SECONDS.
# manual: nothing is triaged until someone presses the button.
TRIAGE_MODE=manual
TRIAGE_INTERVAL_SECONDS=1800

# --- policy (replay-optional; the frontend writes these to the fork) ----------
CONFIDENCE_THRESHOLD=0.6
MAX_CI_ROUNDS=3
MAX_CONCURRENT_WORKERS=6
SCOUT_BATCH_MAX=25
BATCH_WINDOW_SECONDS=60
